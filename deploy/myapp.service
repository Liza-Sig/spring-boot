
[Unit]
Description=Spring Boot Application
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/mnt/c/Users/Admin/IdeaProjects/demo
ExecStartPre=/bin/bash -c 'for i in {1..30}; do /usr/bin/docker info >/dev/null 2>&1 && exit 0; sleep 2; done; echo "Docker is not available" >&2; exit 1'
ExecStart=/usr/bin/docker compose -f deploy/docker-compose.yml up -d
ExecStop=/usr/bin/docker compose -f deploy/docker-compose.yml down
TimeoutStartSec=70

[Install]
WantedBy=multi-user.target
